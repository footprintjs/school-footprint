{
  "name": "school-footprint",
  "version": "0.1.0",
  "description": "School-domain TypeScript workflows and profile configuration for SIS platforms, with scheduling, fees, terminology and recorded service flows.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@footprint/actions": "workspace:*",
    "@footprint/adapters": "workspace:*",
    "@footprint/features": "workspace:*",
    "@footprint/platform": "workspace:*",
    "@footprint/seed": "workspace:*",
    "@footprint/tenancy": "workspace:*",
    "footprintjs": "^4.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "keywords": [
    "typescript",
    "school",
    "sis",
    "school-management",
    "configuration",
    "workflow",
    "footprintjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/footprintjs/school-footprint.git"
  },
  "homepage": "https://github.com/footprintjs/school-footprint#readme",
  "bugs": {
    "url": "https://github.com/footprintjs/school-footprint/issues"
  }
}
